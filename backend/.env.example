PORT=3334
# PostgreSQL do docker-compose.yml (porta 5433 para não conflitar com um Postgres local na 5432)
DATABASE_URL=postgres://moneyflow:moneyflow@localhost:5433/moneyflow
JWT_SECRET=dev-secret-troque-em-producao
# Origens permitidas no CORS, separadas por vírgula (vazio = qualquer origem)
CORS_ORIGIN=

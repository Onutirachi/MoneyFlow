# Variáveis do docker-compose.yml (raiz). Copie para .env e ajuste.
# Na VPS, troque JWT_SECRET e POSTGRES_PASSWORD por valores longos e aleatórios, por exemplo:
#   openssl rand -hex 32

# chave que assina os logins (obrigatória para o container da API subir)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# senha do banco (definida na PRIMEIRA subida; depois disso mudar aqui não muda o banco)
POSTGRES_PASSWORD=moneyflow
# porta em que o site abre (VPS: 80)
WEB_PORT=8080
# porta do banco na própria máquina (127.0.0.1), usada pelo backend em desenvolvimento
DB_PORT=5433
